@page "/"

<PageTitle>Webminder</PageTitle>

<div class="board-container">
    <header class="board-header">Webminder</header>

    <div class="board">
        @for (int r = 0; r < Guesses.Count; r++)
        {
            <GuessRowView Row="Guesses[r]" OnSpotClicked="@( (int i) => CycleColor(r, i) )" />
        }
    </div>

    <div class="controls">
        <button class="btn btn-primary" @onclick="AddRow">Add Row</button>
        <button class="btn btn-link" @onclick="RevealSolution">Reveal Solution</button>
    </div>
</div>

@code {
    private static readonly PieceColor[] PaletteOrder = new[]
    {
        PieceColor.None,
        PieceColor.Red,
        PieceColor.Yellow,
        PieceColor.Green,
        PieceColor.Blue,
        PieceColor.Purple,
        PieceColor.Black,
        PieceColor.White
    };

    // The solution row being guessed against
    private SolutionRow Solution { get; set; } = new(
        new[] { PieceColor.Red, PieceColor.Yellow, PieceColor.Blue, PieceColor.Green }
    );

    // List of guesses and their resolved pins
    private List<GuessRow> Guesses { get; set; } = new();

    protected override void OnInitialized()
    {
        // Initialize with some sample guesses
        Guesses.AddRange(new[] {
            new GuessRow(
                new[] { PieceColor.Yellow, PieceColor.Green, PieceColor.Black, PieceColor.Purple },
                new[] { domain.Pin.None, domain.Pin.None, domain.Pin.None, domain.Pin.None }
            ).Resolve(Solution),
            new GuessRow(
                new[] { PieceColor.Black, PieceColor.Black, PieceColor.Black, PieceColor.Black },
                new[] { domain.Pin.None, domain.Pin.None, domain.Pin.None, domain.Pin.None }
            ).Resolve(Solution),
            new GuessRow(
                new[] { PieceColor.Purple, PieceColor.Blue, PieceColor.Green, PieceColor.Red },
                new[] { domain.Pin.None, domain.Pin.None, domain.Pin.None, domain.Pin.None }
            ).Resolve(Solution)
        });
    }

    private void CycleColor(int row, int spot)
    {
        var guess = Guesses[row];
        var spots = guess.Spots.ToArray(); // create new array to modify
        
        var current = spots[spot];
        var idx = Array.IndexOf(PaletteOrder, current);
        if (idx < 0) idx = 0;
        idx = (idx + 1) % PaletteOrder.Length;
        spots[spot] = PaletteOrder[idx];

        // Create new guess with updated spots and resolve against solution
        Guesses[row] = new GuessRow(spots, Array.Empty<domain.Pin>()).Resolve(Solution);
    }

    private void AddRow()
    {
        var newGuess = new GuessRow(
            new[] { PieceColor.None, PieceColor.None, PieceColor.None, PieceColor.None },
            new[] { domain.Pin.None, domain.Pin.None, domain.Pin.None, domain.Pin.None }
        ).Resolve(Solution);

        Guesses.Insert(0, newGuess);
    }

    private void RevealSolution()
    {
        if (Guesses.Count > 0)
        {
            var revealed = new GuessRow(Solution.Spots, Array.Empty<domain.Pin>()).Resolve(Solution);
            Guesses[0] = revealed;
        }
    }
}
