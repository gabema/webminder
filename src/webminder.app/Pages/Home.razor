@page "/"
@using webminder.app.Shared

<PageTitle>Webminder</PageTitle>

<div class="board-container">
    <header class="board-header">Webminder</header>

    <div class="board">
        @for (int displayIndex = 0; displayIndex < GameBoard.GuessRows.Count; displayIndex++)
        {
            var boardIndex = GameBoard.GuessRows.Count - 1 - displayIndex; // display newest first
            var di = displayIndex; // capture loop variable for closures
            <div class="guess-row-wrapper d-flex align-items-start">
                <GuessRowView Row="GameBoard.GuessRows[boardIndex]" OnSpotClicked="@( (int i) => CycleColor(di, i) )" />

                @if (boardIndex == GameBoard.CurrentRow)
                {
                    <button class="btn btn-outline-secondary ms-2" title="Resolve current guess" @onclick="() => ResolveCurrent()">?</button>
                }
            </div>
        }
    </div>
</div>

@code {
    // The game board (holds guesses, current row and solution)
    private Board GameBoard { get; set; } = Board.New(SolutionRow.Empty);

    protected override void OnInitialized()
    {
        GameBoard = Board.New(SolutionRow.Random());
    }

    private void CycleColor(int displayRow, int spot)
    {
        // map displayed row (newest-first) to board index
        var boardIndex = GameBoard.GuessRows.Count - 1 - displayRow;

        // Only allow cycling on the current board row
        if (boardIndex != GameBoard.CurrentRow)
        {
            return;
        }

        // Bounds check for safety (avoid IndexOutOfRange from corrupted indices)
        var guess = GameBoard.GuessRows[boardIndex];
        if (spot < 0 || spot >= guess.Spots.Length)
        {
            return;
        }

        // Replace the guess on the board and rotate the clicked spot
        GameBoard.GuessRows[boardIndex] = guess.RotateSpot(spot);
    }

    private void ResolveCurrent()
    {
        GameBoard = GameBoard.ResolveGuess();
    }
}
